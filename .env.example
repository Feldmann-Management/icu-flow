DATABASE_URL=postgres://icuflow:icuflow@localhost:55432/icuflow

# Public base URL of this service. Must be reachable from GitHub for webhooks.
# In prod: your real domain (e.g. https://icu-flow.example.com).
# In dev with cloudflared: the tunnel URL.
APP_URL=http://localhost:3000

# Better-Auth session signing key. Generate with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=replace-me-with-a-long-random-string

# OpenAI API key — used by the worker to translate ICU messages.
OPENAI_API_KEY=
